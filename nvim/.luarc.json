{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "workspace.library": ["path/to/library/directory"],
  "runtime.version": "Lua 5.3",
  "hint.enable": false,
  "Lua": {
    "runtime": {
      "version": "LuaJIT",
      "path": [ "?.lua", "?/init.lua" ]
    },
    "diagnostics": {
      "globals": ["vim",
                "linter"]
    },
    "workspace": {
      "library": [
        "/path/to/nvim/runtime/lua",
        "/path/to/nvim/runtime/lua/vim/lsp"
      ]
    }
  }
}
